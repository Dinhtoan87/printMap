# deps
node_modules/
.pnp
.pnp.js
bun.lockb

# build output
.svelte-kit/
build/
dist/
.output/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# data (large / source). The small demo tileset (sample.pmtiles) IS committed
# so the app runs out-of-the-box; real .gdb-derived tiles are ignored.
data/raw/
data/geojson/
data/tiles/*.pmtiles
data/tiles/*.mbtiles
!data/tiles/sample.pmtiles

# sprite is generated by scripts (glyphs are committed so the demo runs out-of-box)
styles/sprite/*.png
styles/sprite/*.json

# playwright / misc
test-results/
*.log
.DS_Store
