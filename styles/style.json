{
  "version": 8,
  "name": "Bản đồ Chuyên đề Tìm kiếm Quy tập Hài cốt Liệt sĩ (Martin real-time)",
  "glyphs": "__API__/glyphs/{fontstack}/{range}.pbf",
  "sprite": "__API__/sprite/sprite",
  "sources": {
    "nen_ban_do": {
      "type": "raster",
      "tiles": ["https://a.tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "© OpenStreetMap contributors"
    },
    "diaphanhanchinhcaphuyen": {
      "type": "vector",
      "tiles": ["__MARTIN__/diaphanhanchinhcaphuyen/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": 20
    },
    "diaphanhanhchinhcapxa": {
      "type": "vector",
      "tiles": ["__MARTIN__/diaphanhanhchinhcapxa/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": 20
    },
    "duongdiagioihanhchinh": {
      "type": "vector",
      "tiles": ["__MARTIN__/duongdiagioihanhchinh/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": 20
    },
    "hientrangkhuvuctkqthclsa": {
      "type": "vector",
      "tiles": ["__MARTIN__/hientrangkhuvuctkqthclsa/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": 20
    },
    "nghiatrangdiaphuonga": {
      "type": "vector",
      "tiles": ["__MARTIN__/nghiatrangdiaphuonga/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": 20
    },
    "nghiatranglietsia": {
      "type": "vector",
      "tiles": ["__MARTIN__/nghiatranglietsia/{z}/{x}/{y}"],
      "minzoom": 0,
      "maxzoom": 20
    },

    "gj_momoiphathien": {
      "type": "geojson",
      "data": "__API__/api/admin/geojson/momoiphathien",
      "cluster": true,
      "clusterRadius": 36,
      "clusterMaxZoom": 16
    },
    "gj_mogiadinh": {
      "type": "geojson",
      "data": "__API__/api/admin/geojson/molietsidogiadinhchamsocquanly",
      "cluster": true,
      "clusterRadius": 44,
      "clusterMaxZoom": 16
    },
    "gj_ntls": {
      "type": "geojson",
      "data": "__API__/api/admin/geojson/nghiatranglietsip",
      "cluster": true,
      "clusterRadius": 36,
      "clusterMaxZoom": 16
    },
    "gj_ntdp": {
      "type": "geojson",
      "data": "__API__/api/admin/geojson/nghiatrangdiaphuongp",
      "cluster": true,
      "clusterRadius": 36,
      "clusterMaxZoom": 16
    }
  },
  "layers": [
    {
      "id": "background-osm",
      "type": "raster",
      "source": "nen_ban_do"
    },

    {
      "id": "fill-hientrang-tkqt",
      "type": "fill",
      "source": "hientrangkhuvuctkqthclsa",
      "source-layer": "hientrangkhuvuctkqthclsa",
      "paint": {
        "fill-antialias": true,
        "fill-opacity": 0.5,
        "fill-color": [
          "match",
          ["get", "hiện trạng tìm kiếm"],
          "Khu vực, địa bàn có mộ liệt sĩ đã tìm kiếm, quy tập xong", "#ffffff",
          "Khu vực địa bàn có thông tin mộ liệt sĩ, đã tìm kiếm, quy tập nhưng chưa hết cần tiếp tục tìm kiếm, quy tập", "#ffff99",
          "Khu vực, địa bàn có thông tin mộ liệt sĩ nhưng chưa tổ chức tìm kiếm, quy tập", "#ccff99",
          "Khu vực, địa bàn có thông tin mộ liệt sĩ đã tìm kiếm quy tập nhưng chưa có kết quả", "#ffb3b3",
          "#c6d9f1"
        ]
      }
    },
    {
      "id": "line-hientrang-tkqt",
      "type": "line",
      "source": "hientrangkhuvuctkqthclsa",
      "source-layer": "hientrangkhuvuctkqthclsa",
      "paint": { "line-color": "#5a5a5a", "line-width": 0.8 }
    },
    {
      "id": "fill-nghiatrang-diaphuong",
      "type": "fill",
      "source": "nghiatrangdiaphuonga",
      "source-layer": "nghiatrangdiaphuonga",
      "paint": { "fill-color": "#cfd8dc", "fill-opacity": 0.55, "fill-outline-color": "#455a64" }
    },
    {
      "id": "fill-nghiatrang-lietsi",
      "type": "fill",
      "source": "nghiatranglietsia",
      "source-layer": "nghiatranglietsia",
      "paint": { "fill-color": "#ffcdd2", "fill-opacity": 0.65, "fill-outline-color": "#c62828" }
    },

    {
      "id": "line-diagioi-phaply",
      "type": "line",
      "source": "duongdiagioihanhchinh",
      "source-layer": "duongdiagioihanhchinh",
      "paint": { "line-color": "#000000", "line-width": 0.6, "line-opacity": 0.45 }
    },
    {
      "id": "line-ranh-huyen",
      "type": "line",
      "source": "diaphanhanchinhcaphuyen",
      "source-layer": "diaphanhanchinhcaphuyen",
      "paint": { "line-color": "#000000", "line-width": 2.2, "line-dasharray": [5, 2, 1, 2] }
    },
    {
      "id": "line-ranh-xa",
      "type": "line",
      "source": "diaphanhanhchinhcapxa",
      "source-layer": "diaphanhanhchinhcapxa",
      "paint": { "line-color": "#ff00ff", "line-width": 1.3, "line-dasharray": [4, 2] }
    },

    {
      "id": "label-xa",
      "type": "symbol",
      "source": "diaphanhanhchinhcapxa",
      "source-layer": "diaphanhanhchinhcapxa",
      "minzoom": 10,
      "layout": {
        "text-field": ["coalesce", ["get", "ten"], ""],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-anchor": "center",
        "text-max-width": 8
      },
      "paint": { "text-color": "#4a148c", "text-halo-color": "#ffffff", "text-halo-width": 1.6 }
    },
    {
      "id": "label-huyen",
      "type": "symbol",
      "source": "diaphanhanchinhcaphuyen",
      "source-layer": "diaphanhanchinhcaphuyen",
      "minzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "ten"], ""],
        "text-font": ["Noto Sans Bold"],
        "text-size": 15,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.05,
        "text-anchor": "center",
        "text-max-width": 9
      },
      "paint": { "text-color": "#000000", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },

    {
      "id": "ntdp-cluster",
      "type": "symbol",
      "source": "gj_ntdp",
      "filter": ["has", "point_count"],
      "layout": {
        "icon-image": "grave-black",
        "icon-size": 0.9,
        "icon-allow-overlap": true,
        "text-field": ["get", "point_count_abbreviated"],
        "text-font": ["Noto Sans Bold"],
        "text-size": 13,
        "text-offset": [1.0, -0.8],
        "text-allow-overlap": true
      },
      "paint": { "text-color": "#263238", "text-halo-color": "#ffffff", "text-halo-width": 1.8 }
    },
    {
      "id": "ntdp-point",
      "type": "symbol",
      "source": "gj_ntdp",
      "filter": ["!", ["has", "point_count"]],
      "layout": { "icon-image": "grave-black", "icon-size": 0.9, "icon-allow-overlap": true }
    },

    {
      "id": "ntls-cluster",
      "type": "symbol",
      "source": "gj_ntls",
      "filter": ["has", "point_count"],
      "layout": {
        "icon-image": "ntls",
        "icon-size": 0.9,
        "icon-allow-overlap": true,
        "text-field": ["get", "point_count_abbreviated"],
        "text-font": ["Noto Sans Bold"],
        "text-size": 13,
        "text-offset": [1.0, -0.8],
        "text-allow-overlap": true
      },
      "paint": { "text-color": "#b71c1c", "text-halo-color": "#ffffff", "text-halo-width": 1.8 }
    },
    {
      "id": "ntls-point",
      "type": "symbol",
      "source": "gj_ntls",
      "filter": ["!", ["has", "point_count"]],
      "layout": { "icon-image": "ntls", "icon-size": 0.9, "icon-allow-overlap": true }
    },

    {
      "id": "mogiadinh-cluster",
      "type": "symbol",
      "source": "gj_mogiadinh",
      "filter": ["has", "point_count"],
      "layout": {
        "icon-image": "grave-green",
        "icon-size": 0.95,
        "icon-allow-overlap": true,
        "text-field": ["get", "point_count_abbreviated"],
        "text-font": ["Noto Sans Bold"],
        "text-size": 13,
        "text-offset": [1.0, -0.8],
        "text-allow-overlap": true
      },
      "paint": { "text-color": "#1b5e20", "text-halo-color": "#ffffff", "text-halo-width": 1.8 }
    },
    {
      "id": "mogiadinh-point",
      "type": "symbol",
      "source": "gj_mogiadinh",
      "filter": ["!", ["has", "point_count"]],
      "layout": { "icon-image": "grave-green", "icon-size": 0.95, "icon-allow-overlap": true }
    },

    {
      "id": "momoi-cluster",
      "type": "symbol",
      "source": "gj_momoiphathien",
      "filter": ["has", "point_count"],
      "layout": {
        "icon-image": "grave-red",
        "icon-size": 0.95,
        "icon-allow-overlap": true,
        "text-field": ["get", "point_count_abbreviated"],
        "text-font": ["Noto Sans Bold"],
        "text-size": 13,
        "text-offset": [1.0, -0.8],
        "text-allow-overlap": true
      },
      "paint": { "text-color": "#b71c1c", "text-halo-color": "#ffffff", "text-halo-width": 1.8 }
    },
    {
      "id": "momoi-point",
      "type": "symbol",
      "source": "gj_momoiphathien",
      "filter": ["!", ["has", "point_count"]],
      "layout": { "icon-image": "grave-red", "icon-size": 0.95, "icon-allow-overlap": true }
    }
  ]
}
