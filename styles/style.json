{
  "version": 8,
  "name": "PrintMap (PMTiles)",
  "metadata": {
    "note": "Style production dùng nguồn vector .pmtiles. 'source-layer' phải khớp tên -L khi chạy tippecanoe (xem scripts/geojson-to-pmtiles.sh)."
  },
  "glyphs": "__API__/glyphs/{fontstack}/{range}.pbf",
  "sprite": "__API__/sprite/sprite",
  "sources": {
    "map": { "type": "vector", "url": "pmtiles://__API__/tiles/map.pmtiles" }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#f7f6f2" } },

    { "id": "diagioi-fill", "type": "fill", "source": "map", "source-layer": "diagioi",
      "filter": ["==", ["get", "cap"], "xa"],
      "paint": { "fill-color": "#ffffff", "fill-opacity": 0.15, "fill-outline-color": "#ff00ff" } },
    { "id": "thuyhe-fill", "type": "fill", "source": "map", "source-layer": "thuyhe",
      "paint": { "fill-color": "#c2ffff", "fill-outline-color": "#00cccc" } },

    { "id": "diagioi-xa", "type": "line", "source": "map", "source-layer": "diagioi",
      "filter": ["==", ["get", "cap"], "xa"],
      "paint": { "line-color": "#ff00ff", "line-width": 1.5, "line-dasharray": [3, 2] } },
    { "id": "diagioi-huyen", "type": "line", "source": "map", "source-layer": "diagioi",
      "filter": ["==", ["get", "cap"], "huyen"],
      "paint": { "line-color": "#000000", "line-width": 3, "line-dasharray": [4, 2] } },

    { "id": "duongsat-base", "type": "line", "source": "map", "source-layer": "duongsat",
      "paint": { "line-color": "#000000", "line-width": 2 } },
    { "id": "duongsat-ties", "type": "line", "source": "map", "source-layer": "duongsat",
      "paint": { "line-color": "#ffffff", "line-width": 2, "line-dasharray": [1, 2] } },

    { "id": "giaothong-casing", "type": "line", "source": "map", "source-layer": "giaothong",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#7a3a00", "line-width": 6 } },
    { "id": "giaothong-line", "type": "line", "source": "map", "source-layer": "giaothong",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#d35400", "line-width": 3.5 } },

    { "id": "mols-pts", "type": "circle", "source": "map", "source-layer": "mols",
      "paint": {
        "circle-radius": 6,
        "circle-stroke-width": 1.5,
        "circle-stroke-color": "#000000",
        "circle-color": [
          "match", ["get", "trangthai"],
          "moi", "#ff0000",
          "giadinh", "#00b050",
          "nghiatrang", "#ff0000",
          "xong", "#ffffff",
          "tieptuc", "#ffff99",
          "chua", "#ccff99",
          "chuaketqua", "#ffb3b3",
          "khongro", "#c6d9f1",
          "#888888"
        ]
      }
    },

    { "id": "diemdc-pts", "type": "circle", "source": "map", "source-layer": "diemdc",
      "paint": { "circle-radius": 5, "circle-color": "#000000", "circle-stroke-color": "#ffffff", "circle-stroke-width": 1.5 } },

    { "id": "diagioi-label", "type": "symbol", "source": "map", "source-layer": "diagioi",
      "filter": ["==", ["get", "cap"], "xa"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"], "text-size": 13 },
      "paint": { "text-color": "#333", "text-halo-color": "#fff", "text-halo-width": 1.5 } },
    { "id": "diemdc-label", "type": "symbol", "source": "map", "source-layer": "diemdc",
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12, "text-offset": [0, 1.2], "text-anchor": "top" },
      "paint": { "text-color": "#000", "text-halo-color": "#fff", "text-halo-width": 1.5 } }
  ]
}
