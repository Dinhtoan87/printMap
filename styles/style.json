{
  "version": 8,
  "name": "PrintMap (Martin + raster mbtiles)",
  "metadata": {
    "note": "Style production: nền ảnh raster từ data/tiles/nen.mbtiles (API /mbtiles/...), lớp chuyên đề vector từ Martin (PostGIS, DATABASE_URL). Tên source = tên bảng trong Postgres; 'source-layer' của Martin table-source cũng chính là tên bảng. Đổi tên tại đây cho khớp CSDL của bạn."
  },
  "glyphs": "__API__/glyphs/{fontstack}/{range}.pbf",
  "sprite": "__API__/sprite/sprite",
  "sources": {
    "nen": {
      "type": "raster",
      "tiles": ["__API__/mbtiles/nen/{z}/{x}/{y}"],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 18
    },
    "diaphanhanhchinhcapxa": { "type": "vector", "url": "__MARTIN__/diaphanhanhchinhcapxa" },
    "thuyhe": { "type": "vector", "url": "__MARTIN__/thuyhe" },
    "giaothong": { "type": "vector", "url": "__MARTIN__/giaothong" },
    "duongsat": { "type": "vector", "url": "__MARTIN__/duongsat" },
    "mols": { "type": "vector", "url": "__MARTIN__/mols" },
    "diemdc": { "type": "vector", "url": "__MARTIN__/diemdc" }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#f7f6f2" } },

    { "id": "nen-raster", "type": "raster", "source": "nen",
      "paint": { "raster-opacity": 1 } },

    { "id": "thuyhe-fill", "type": "fill", "source": "thuyhe", "source-layer": "thuyhe",
      "paint": { "fill-color": "#c2ffff", "fill-opacity": 0.85, "fill-outline-color": "#00cccc" } },

    { "id": "diagioi-xa", "type": "line", "source": "diaphanhanhchinhcapxa", "source-layer": "diaphanhanhchinhcapxa",
      "paint": { "line-color": "#ff00ff", "line-width": 1.6, "line-dasharray": [3, 2] } },

    { "id": "duongsat-base", "type": "line", "source": "duongsat", "source-layer": "duongsat",
      "paint": { "line-color": "#000000", "line-width": 2 } },
    { "id": "duongsat-ties", "type": "line", "source": "duongsat", "source-layer": "duongsat",
      "paint": { "line-color": "#ffffff", "line-width": 2, "line-dasharray": [1, 2] } },

    { "id": "giaothong-casing", "type": "line", "source": "giaothong", "source-layer": "giaothong",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#7a3a00", "line-width": 6 } },
    { "id": "giaothong-line", "type": "line", "source": "giaothong", "source-layer": "giaothong",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#d35400", "line-width": 3.5 } },

    { "id": "mols-pts", "type": "symbol", "source": "mols", "source-layer": "mols",
      "layout": {
        "icon-image": ["match", ["get", "trangthai"],
          "moi", "grave-red",
          "tieptuc", "grave-red",
          "chuaketqua", "grave-red",
          "giadinh", "grave-green",
          "chua", "grave-green",
          "nghiatrang", "ntls",
          "xong", "grave-black",
          "khongro", "grave-black",
          "grave-black"],
        "icon-size": 0.9,
        "icon-allow-overlap": true
      } },

    { "id": "diemdc-pts", "type": "symbol", "source": "diemdc", "source-layer": "diemdc",
      "layout": {
        "icon-image": ["match", ["get", "loai"],
          "ubnd_huyen", "ubnd-huyen",
          "ubnd_xa", "ubnd-xa",
          "qs_huyen", "qs-huyen",
          "qs_tinh", "qs-tinh",
          "dcs-nongthon"],
        "icon-size": 0.9,
        "icon-allow-overlap": true
      } },

    { "id": "tenxa-label", "type": "symbol", "source": "diaphanhanhchinhcapxa", "source-layer": "diaphanhanhchinhcapxa",
      "layout": {
        "symbol-placement": "point",
        "text-field": ["get", "tenxa"],
        "text-font": ["Noto Sans Bold"],
        "text-size": 13
      },
      "paint": { "text-color": "#333", "text-halo-color": "#fff", "text-halo-width": 1.5 } },

    { "id": "diemdc-label", "type": "symbol", "source": "diemdc", "source-layer": "diemdc",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-offset": [0, 1.2],
        "text-anchor": "top"
      },
      "paint": { "text-color": "#000", "text-halo-color": "#fff", "text-halo-width": 1.5 } }
  ]
}
