# ── Cổng API (Elysia) ─────────────────────────────────────────────
# Martin dùng cổng 3000, nên API để 3001 cho khỏi đụng.
PORT=3001

# URL công khai của chính API này (chèn vào style.json thay cho __API__)
PUBLIC_API_URL=http://localhost:3001

# URL web SvelteKit (dùng cho render in server-side qua Playwright)
WEB_URL=http://localhost:5173

# ── Martin tile server (thay __MARTIN__ trong styles/style.json) ───
# Martin publish mỗi bảng PostGIS thành 1 nguồn vector tiles tại /<ten_bang>/{z}/{x}/{y}
MARTIN_URL=http://localhost:3000

# ── PostGIS chứa các lớp chuyên đề ────────────────────────────────
# Bỏ trống -> API tự rơi về dữ liệu mẫu data/sample/.
# Khi API chạy TRÊN HOST (không trong docker) hãy dùng host "localhost"
# (không dùng "infra-postgres-1" — tên này chỉ phân giải trong docker network).
DATABASE_URL=postgresql://mapviet:mapviet_dev_password@localhost:5432/printdb

# ── Chromium cho Playwright (xuất PDF/PNG chất lượng cao) ──────────
# Windows/macOS: ĐỂ TRỐNG -> tự dùng Edge/Chrome hệ thống (hoặc `bunx playwright install chromium`).
# Chỉ đặt khi chạy Linux/CI có Chromium cài sẵn; đường dẫn không tồn tại sẽ bị bỏ qua.
# PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium

# (Tùy chọn) node dùng cho tiến trình render. Mặc định "node" trong PATH.
# NODE_BIN=node
