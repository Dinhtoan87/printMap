# Cổng API
PORT=3000

# URL công khai của chính API này (dùng để chèn vào style.json thay cho __API__)
PUBLIC_API_URL=http://localhost:3000

# URL của web SvelteKit (dùng cho render in server-side qua Playwright)
WEB_URL=http://localhost:5173

# Đường dẫn Chromium cho Playwright (môi trường này đã cài sẵn)
PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium

# URL công khai của Martin tile server (thay __MARTIN__ trong styles/style.json)
MARTIN_URL=http://localhost:3001

# PostGIS chứa các lớp chuyên đề (diaphanhanhchinhcapxa, mols, ...).
# Bỏ trống -> API tự rơi về dữ liệu mẫu data/sample/.
# Lưu ý: host "infra-postgres-1" chỉ phân giải được trong docker network của bạn;
# khi chạy API ngoài docker hãy đổi thành localhost (hoặc IP máy chủ DB).
# DATABASE_URL=postgresql://mapviet:mapviet_dev_password@infra-postgres-1:5432/printdb
