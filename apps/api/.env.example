# ── Cổng API (Elysia) ─────────────────────────────────────────────
# Martin dùng cổng 3000, nên API để 3001 cho khỏi đụng.
PORT=3001

# URL công khai của chính API này (chèn vào style.json thay cho __API__)
PUBLIC_API_URL=http://localhost:3001

# URL web SvelteKit (dùng cho render in server-side qua Playwright)
WEB_URL=http://print.samcom.net:5173

# ── Martin tile server (thay __MARTIN__ trong styles/style.json) ───
# Martin publish mỗi bảng PostGIS thành 1 nguồn vector tiles tại /<ten_bang>/{z}/{x}/{y}
MARTIN_URL=http://localhost:3000

# ── PostGIS chứa các lớp chuyên đề ────────────────────────────────
# Bỏ trống -> API tự rơi về dữ liệu mẫu data/sample/.
# Khi API chạy TRÊN HOST (không trong docker) hãy dùng host "localhost"
# (không dùng "infra-postgres-1" — tên này chỉ phân giải trong docker network).
DATABASE_URL=postgresql://mapviet:mapviet_dev_password@localhost:5432/printdb

# ── Chromium cho Playwright (xuất PDF/PNG chất lượng cao) ──────────
# Windows/macOS: ĐỂ TRỐNG -> tự dùng Edge/Chrome hệ thống (hoặc `bunx playwright install chromium`).
# Chỉ đặt khi chạy Linux/CI có Chromium cài sẵn; đường dẫn không tồn tại sẽ bị bỏ qua.
# PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium

# (Tùy chọn) node dùng cho tiến trình render. Mặc định "node" trong PATH.
# NODE_BIN=node

# ── Xác thực: dùng lại phiên đăng nhập của SERVER A (better-auth) ──
# Server in KHÔNG có trang đăng nhập. Nó chỉ VERIFY cookie/bearer do server A phát ra.
# BETTER_AUTH_SECRET phải GIỐNG HỆT server A, sai một ký tự là mọi request 401.
BETTER_AUTH_SECRET=
# URL better-auth của server A (dùng làm baseURL và gợi ý trang đăng nhập trong lỗi 401).
BETTER_AUTH_URL=http://auth.samcom.net:3000

# CSDL chứa bảng `session`/`user` của server A. THƯỜNG KHÁC CSDL bản đồ ở trên —
# kiểm tra bằng cách đăng nhập rồi tìm token trong bảng `session`. Bỏ trống -> dùng DATABASE_URL.
AUTH_DATABASE_URL=

# Kiểu tên cột của CSDL xác thực: snake (expires_at, user_id) | camel (expiresAt, userId).
# Mặc định snake vì server A đang dùng snake_case; khai sai -> API trả 503.
AUTH_DB_NAMING=snake

# Tắt kiểm tra đăng nhập (CHỈ dev cục bộ). Mặc định true = bắt buộc đăng nhập.
# AUTH_REQUIRED=false

# Origin được phép gọi API kèm cookie. Bỏ trống -> phản chiếu mọi origin (chỉ nên dùng khi dev).
# CORS_ORIGINS=http://print.samcom.net:5173,http://auth.samcom.net:3000

# Origin được better-auth tin cậy (mặc định đã gồm WEB_URL, PUBLIC_API_URL, BETTER_AUTH_URL).
# AUTH_TRUSTED_ORIGINS=
