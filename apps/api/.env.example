# Cổng API
PORT=3000

# URL công khai của chính API này (dùng để chèn vào style.json thay cho __API__)
PUBLIC_API_URL=http://localhost:3000

# URL của web SvelteKit (dùng cho render in server-side qua Playwright)
WEB_URL=http://localhost:5173

# Đường dẫn Chromium cho Playwright (môi trường này đã cài sẵn)
PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium

# (Tùy chọn) PostGIS nếu dùng nguồn postgres
# PG_URL=postgres://gis:gis@localhost:5432/gis
