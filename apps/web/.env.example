# URL của API (Elysia). Dùng để lấy style, tiles, glyphs và gọi render in.
PUBLIC_API_URL=http://localhost:3001

# Tên style: "style.sample" (demo GeoJSON) hoặc "style" (production pmtiles)
PUBLIC_STYLE_NAME=style

# Trang đăng nhập của server A (better-auth). Hiện link "Đăng nhập" khi phiên hết hạn.
# Bỏ trống -> chỉ hiện cảnh báo, không kèm link.
PUBLIC_LOGIN_URL=
